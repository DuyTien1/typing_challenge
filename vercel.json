{
  "version": 2,
  "framework": "vite",
  "buildCommand": "vite build && esbuild server/serverless.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.js",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api|assets|favicon|og-image).*)",
      "destination": "/index.html"
    }
  ]
}
